# How every file in the repo is written: UTF-8, LF, a final newline, no trailing spaces, two
# spaces to indent. Python and the Android project (Gradle, Java) use four, as their tools do.
# Test fixtures are captured responses, kept byte for byte as their source sent them.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{py,gradle,java}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[{pipeline/tests/fixtures,web/src/__tests__/fixtures}/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
